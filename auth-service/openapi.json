{
  "openapi": "3.0.3",
  "info": {
    "title": "Auth Service API — Microsserviço de Autenticação",
    "description": "API responsável pela autenticação, registro de usuários, controle de papéis (RBAC) e recuperação de senha via e-mail.",
    "version": "1.0.0",
    "contact": {
      "name": "Tom Hanks Catalog Team",
      "url": "https://github.com/glaffamabili/catalogo-tom-hanks"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor Local / Produção"
    }
  ],
  "tags": [
    { "name": "Autenticação", "description": "Endpoints de login, cadastro e recuperação de senha" },
    { "name": "Usuários & RBAC", "description": "Consulta de perfis e gerenciamento de papéis" },
    { "name": "Observabilidade", "description": "Health check e métricas do sistema" }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Cadastrar novo usuário",
        "description": "Cadastra um usuário com senha hasheada (bcrypt) e envia e-mail de boas-vindas.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "email", "senha"],
                "properties": {
                  "nome": { "type": "string", "example": "Tom Hanks" },
                  "email": { "type": "string", "format": "email", "example": "tom@exemplo.com" },
                  "senha": { "type": "string", "format": "password", "example": "senhaForte123" },
                  "role": { "type": "string", "enum": ["usuario", "admin"], "default": "usuario", "example": "usuario" },
                  "appUrl": { "type": "string", "example": "https://meusite.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuário cadastrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "userId": { "type": "integer", "example": 1 },
                    "role": { "type": "string", "example": "usuario" }
                  }
                }
              }
            }
          },
          "400": { "description": "Dados incompletos ou e-mail já em uso" },
          "500": { "description": "Erro interno no servidor de banco de dados" }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Autenticar usuário",
        "description": "Valida e-mail e hash da senha com bcrypt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "tom@exemplo.com" },
                  "senha": { "type": "string", "format": "password", "example": "senhaForte123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "userId": { "type": "integer", "example": 1 },
                    "nome": { "type": "string", "example": "Tom Hanks" },
                    "role": { "type": "string", "example": "usuario" }
                  }
                }
              }
            }
          },
          "401": { "description": "Credenciais inválidas" },
          "500": { "description": "Erro interno" }
        }
      }
    },
    "/forgot-password": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Solicitar recuperação de senha",
        "description": "Gera token seguro válido por 30 minutos e dispara e-mail com link de redefinição.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "tom@exemplo.com" },
                  "appUrl": { "type": "string", "example": "https://meusite.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "E-mail de recuperação enviado com sucesso" },
          "400": { "description": "E-mail não informado" },
          "404": { "description": "E-mail não encontrado no sistema" },
          "500": { "description": "Erro no envio de e-mail ou configuração SMTP" }
        }
      }
    },
    "/reset-password": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Redefinir senha com token",
        "description": "Valida o token de uso único e expiração de 30 min, atualizando o hash da senha.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "novaSenha"],
                "properties": {
                  "token": { "type": "string", "example": "a1b2c3d4e5f6..." },
                  "novaSenha": { "type": "string", "format": "password", "example": "novaSenha123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Senha redefinida com sucesso" },
          "400": { "description": "Token inválido, expirado ou dados incompletos" },
          "500": { "description": "Erro interno" }
        }
      }
    },
    "/verify-user/{id}": {
      "get": {
        "tags": ["Usuários & RBAC"],
        "summary": "Consultar dados e papel de um usuário",
        "description": "Usado internamente pelo Catálogo para validação de sessão e RBAC (Padrão A).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID do usuário"
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário retornados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer", "example": 1 },
                    "nome": { "type": "string", "example": "Tom Hanks" },
                    "email": { "type": "string", "example": "tom@exemplo.com" },
                    "role": { "type": "string", "example": "admin" }
                  }
                }
              }
            }
          },
          "404": { "description": "Usuário não encontrado" },
          "500": { "description": "Erro no banco" }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Usuários & RBAC"],
        "summary": "Listar todos os usuários cadastrados",
        "description": "Retorna todos os usuários e seus respectivos papéis para gerenciamento administrativo.",
        "responses": {
          "200": {
            "description": "Lista de usuários",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "nome": { "type": "string" },
                      "email": { "type": "string" },
                      "role": { "type": "string", "enum": ["usuario", "admin"] }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}/role": {
      "patch": {
        "tags": ["Usuários & RBAC"],
        "summary": "Alterar papel (role) do usuário",
        "description": "Promove a admin ou rebaixa para usuario comum.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["role"],
                "properties": {
                  "role": { "type": "string", "enum": ["usuario", "admin"], "example": "admin" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Papel atualizado com sucesso" },
          "400": { "description": "Papel inválido" },
          "404": { "description": "Usuário não encontrado" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Observabilidade"],
        "summary": "Verificação de Saúde (Liveness & Readiness)",
        "description": "Testa conectividade real com banco MariaDB/MySQL. Retorna 200 se saudável ou 503 se indisponível.",
        "responses": {
          "200": { "description": "Serviço saudável e pronto para receber tráfego" },
          "503": { "description": "Serviço com falha em dependência crítica (ex: banco de dados inacessível)" }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Observabilidade"],
        "summary": "Métricas Prometheus",
        "description": "Exponibiliza contadores de requisições, latências e uso de recursos em formato padrão Prometheus.",
        "responses": {
          "200": { "description": "Texto puro com métricas no padrão Prometheus" }
        }
      }
    }
  }
}


{
  "openapi": "3.0.3",
  "info": {
    "title": "Catalog Service API — Catálogo & Rede Social Tom Hanks",
    "description": "API principal do Catálogo e Rede Social de Filmes Tom Hanks com autenticação 2FA, validação de e-mails reais, armazenamento de fotos no MinIO Object Storage, auditoria via Redis Streams e moderação RBAC.",
    "version": "1.0.0",
    "contact": {
      "name": "Tom Hanks Catalog Team",
      "url": "https://github.com/glaffamabili/catalogo-tom-hanks"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor da Aplicação"
    }
  ],
  "tags": [
    { "name": "Autenticação & 2FA", "description": "Endpoints de cadastro com validação de e-mail real, ativação e login com verificação em duas etapas" },
    { "name": "Perfil Social & MinIO", "description": "Gerenciamento de perfil, biografia e fotos de avatar no Object Storage MinIO" },
    { "name": "Catálogo de Filmes", "description": "Consulta de filmografia via API The Movie Database (TMDB)" },
    { "name": "Favoritos", "description": "Gerenciamento de filmes favoritos do usuário" },
    { "name": "Comentários & Moderação RBAC", "description": "Postagem e moderação comunitária restrita por papel" },
    { "name": "Administração & Auditoria", "description": "Gerenciamento de usuários e consulta de logs no Redis Streams" },
    { "name": "Pagamentos & Stripe (Atividade 7)", "description": "Endpoints de Checkout, Webhooks assinados e gestão do Plano Premium via Stripe" },
    { "name": "Observabilidade", "description": "Health checks de dependências e métricas Prometheus" }
  ],
  "paths": {
    "/api/register": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Cadastrar novo usuário com validação de e-mail real e envio de código de ativação",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "email", "senha"],
                "properties": {
                  "nome": { "type": "string", "example": "Amabili Flor" },
                  "email": { "type": "string", "example": "usuario@gmail.com" },
                  "senha": { "type": "string", "example": "senha123" },
                  "role": { "type": "string", "enum": ["usuario", "admin"], "default": "usuario" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Código de ativação enviado para o e-mail real" },
          "400": { "description": "E-mail inválido, inexistente ou já em uso" }
        }
      }
    },
    "/api/verify-email": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Ativar conta informando o código de 6 dígitos recebido por e-mail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "codigo"],
                "properties": {
                  "email": { "type": "string", "example": "usuario@gmail.com" },
                  "codigo": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Conta ativada com sucesso" },
          "400": { "description": "Código incorreto ou expirado" }
        }
      }
    },
    "/api/login": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Iniciar login e solicitar código de verificação em 2 etapas (2FA)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "senha"],
                "properties": {
                  "email": { "type": "string", "example": "usuario@gmail.com" },
                  "senha": { "type": "string", "example": "senha123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Código de 2 etapas enviado para o e-mail" },
          "401": { "description": "Credenciais inválidas" },
          "403": { "description": "Conta pendente de ativação" }
        }
      }
    },
    "/api/verify-2fa": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Confirmar código 2FA e iniciar sessão autenticada",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "codigo"],
                "properties": {
                  "email": { "type": "string", "example": "usuario@gmail.com" },
                  "codigo": { "type": "string", "example": "654321" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Autenticado com sucesso na sessão" },
          "400": { "description": "Código 2FA incorreto ou expirado" }
        }
      }
    },
    "/api/resend-code": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Reenviar código de segurança (ativação ou 2FA)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "tipo"],
                "properties": {
                  "email": { "type": "string" },
                  "tipo": { "type": "string", "enum": ["EMAIL_VERIFICACAO", "LOGIN_2FA"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Novo código enviado" }
        }
      }
    },
    "/api/forgot-password": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Solicitar link de recuperação de senha por e-mail",
        "responses": { "200": { "description": "Link enviado" } }
      }
    },
    "/api/reset-password": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Redefinir senha com token",
        "responses": { "200": { "description": "Senha atualizada" } }
      }
    },
    "/api/logout": {
      "post": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Encerrar sessão ativa",
        "responses": { "200": { "description": "Sessão encerrada" } }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["Autenticação & 2FA"],
        "summary": "Consultar dados do usuário autenticado na sessão",
        "responses": { "200": { "description": "Dados do usuário logado" } }
      }
    },
    "/api/profile": {
      "get": {
        "tags": ["Perfil Social & MinIO"],
        "summary": "Obter perfil social completo do usuário logado com estatísticas",
        "responses": { "200": { "description": "Perfil com estatísticas, favoritos e foto" } }
      },
      "put": {
        "tags": ["Perfil Social & MinIO"],
        "summary": "Atualizar biografia e nome de exibição",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "bio": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Perfil atualizado com sucesso" } }
      }
    },
    "/api/profile/{id}": {
      "get": {
        "tags": ["Perfil Social & MinIO"],
        "summary": "Consultar perfil público de outro usuário (Sem expor e-mails ou senhas)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Dados públicos do usuário" } }
      }
    },
    "/api/profile/upload-photo": {
      "post": {
        "tags": ["Perfil Social & MinIO"],
        "summary": "Upload de foto de perfil para o Object Storage MinIO",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "foto": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Foto enviada e armazenada no MinIO com sucesso" } }
      }
    },
    "/api/profile/avatar/{key}": {
      "get": {
        "tags": ["Perfil Social & MinIO"],
        "summary": "Download / Streaming da imagem de avatar armazenada no MinIO",
        "parameters": [
          { "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Arquivo de imagem binária" } }
      }
    },
    "/api/movies": {
      "get": {
        "tags": ["Catálogo de Filmes"],
        "summary": "Listar filmografia de Tom Hanks via TMDB",
        "responses": { "200": { "description": "Lista de filmes" } }
      }
    },
    "/api/favorites": {
      "get": {
        "tags": ["Favoritos"],
        "summary": "Listar favoritos do usuário",
        "responses": { "200": { "description": "Lista de favoritos" } }
      },
      "post": {
        "tags": ["Favoritos"],
        "summary": "Adicionar filme aos favoritos",
        "responses": { "200": { "description": "Filme favoritado" } }
      }
    },
    "/api/favorites/{tmdbId}": {
      "delete": {
        "tags": ["Favoritos"],
        "summary": "Remover filme dos favoritos",
        "parameters": [
          { "name": "tmdbId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Filme removido" } }
      }
    },
    "/api/comments": {
      "get": {
        "tags": ["Comentários & Moderação RBAC"],
        "summary": "Listar comentários com avatares e autores",
        "responses": { "200": { "description": "Lista de comentários" } }
      },
      "post": {
        "tags": ["Comentários & Moderação RBAC"],
        "summary": "Publicar comentário em um filme",
        "responses": { "200": { "description": "Comentário salvo" } }
      }
    },
    "/api/comments/{id}": {
      "delete": {
        "tags": ["Comentários & Moderação RBAC"],
        "summary": "Excluir comentário (Dono ou Admin para moderação)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Comentário excluído" },
          "403": { "description": "Acesso negado: 403 Forbidden" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Administração & Auditoria"],
        "summary": "Listar usuários cadastrados (Exclusivo Admin)",
        "responses": { "200": { "description": "Lista de usuários" } }
      }
    },
    "/api/users/{id}/role": {
      "patch": {
        "tags": ["Administração & Auditoria"],
        "summary": "Alterar papel RBAC de usuário (Exclusivo Admin)",
        "responses": { "200": { "description": "Papel atualizado" } }
      }
    },
    "/api/admin/logs": {
      "get": {
        "tags": ["Administração & Auditoria"],
        "summary": "Consultar logs de auditoria no Redis Streams (Exclusivo Admin)",
        "responses": { "200": { "description": "Lista de eventos de auditoria" } }
      }
    },
    "/api/premium/checkout": {
      "post": {
        "tags": ["Pagamentos & Stripe (Atividade 7)"],
        "summary": "Criar uma Stripe Checkout Session para o Plano Premium (R$ 9,90/mês)",
        "responses": {
          "200": {
            "description": "Sessão do Stripe criada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessionId": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": { "description": "Usuário não autenticado" }
        }
      }
    },
    "/api/webhooks/stripe": {
      "post": {
        "tags": ["Pagamentos & Stripe (Atividade 7)"],
        "summary": "Receber e processar Webhooks assinados criptograficamente pelo Stripe",
        "description": "Valida o header `stripe-signature` com HMAC SHA-256 e atualiza o usuário no banco para `is_premium: 1` de forma assíncrona quando o evento `checkout.session.completed` for recebido.",
        "responses": {
          "200": { "description": "Webhook processado com sucesso" },
          "400": { "description": "Assinatura do webhook inválida ou erro no payload" }
        }
      }
    },
    "/api/premium/status": {
      "get": {
        "tags": ["Pagamentos & Stripe (Atividade 7)"],
        "summary": "Consultar status do Plano Premium do usuário logado",
        "responses": {
          "200": {
            "description": "Status da assinatura retornado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "is_premium": { "type": "boolean" },
                    "stripe_customer_id": { "type": "string" },
                    "stripe_subscription_id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/premium/cancel": {
      "post": {
        "tags": ["Pagamentos & Stripe (Atividade 7)"],
        "summary": "Cancelar assinatura do Plano Premium e reverter privilégios para usuário comum",
        "responses": {
          "200": { "description": "Assinatura cancelada" }
        }
      }
    },
    "/api/premium/simulate-webhook": {
      "post": {
        "tags": ["Pagamentos & Stripe (Atividade 7)"],
        "summary": "Simular confirmação de pagamento para testes locais / CI sem chave Stripe real",
        "responses": {
          "200": { "description": "Simulação concluída com sucesso" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Observabilidade"],
        "summary": "Health check de todas as dependências (MariaDB, Auth, Redis Streams, MinIO)",
        "responses": { "200": { "description": "Todos os serviços saudáveis" } }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Observabilidade"],
        "summary": "Métricas no padrão Prometheus (OpenMetrics)",
        "responses": { "200": { "description": "Métricas do sistema" } }
      }
    }
  }
}
